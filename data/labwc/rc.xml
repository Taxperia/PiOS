<?xml version="1.0"?>
<labwc_config>
  <core>
    <decoration>server</decoration>
    <gap>8</gap>
    <adaptiveSync>yes</adaptiveSync>
  </core>
  <theme>
    <name>Fidan</name>
    <cornerRadius>10</cornerRadius>
    <dropShadows>yes</dropShadows>
  </theme>
  <desktops number="3">
    <names>
      <name>1</name>
      <name>2</name>
      <name>3</name>
    </names>
    <popupTime>0</popupTime>
  </desktops>
  <keyboard>
    <default />
    <keybind key="W-space"><action name="Execute" command="fidan-shellctl launcher toggle" /></keybind>
    <keybind key="W-e"><action name="Execute" command="fidan-files" /></keybind>
    <keybind key="W-i"><action name="Execute" command="fidan-shellctl settings" /></keybind>
    <keybind key="C-S-Escape"><action name="Execute" command="fidan-task-manager" /></keybind>
    <keybind key="Print"><action name="Execute" command="fidan-screenshot" /></keybind>
    <keybind key="W-S-s"><action name="Execute" command="fidan-screenshot --region" /></keybind>
    <keybind key="W-1"><action name="Execute" command="fidan-shellctl workspace 1" /></keybind>
    <keybind key="W-2"><action name="Execute" command="fidan-shellctl workspace 2" /></keybind>
    <keybind key="W-3"><action name="Execute" command="fidan-shellctl workspace 3" /></keybind>
    <keybind key="C-A-1"><action name="GoToDesktop" to="1" /></keybind>
    <keybind key="C-A-2"><action name="GoToDesktop" to="2" /></keybind>
    <keybind key="C-A-3"><action name="GoToDesktop" to="3" /></keybind>
    <keybind key="W-l"><action name="Execute" command="fidan-lock" /></keybind>
    <keybind key="C-A-t"><action name="Execute" command="qterminal" /></keybind>
    <keybind key="A-Tab"><action name="NextWindow" /></keybind>
    <keybind key="A-S-Tab"><action name="PreviousWindow" /></keybind>
    <keybind key="W-Down"><action name="Iconify" /></keybind>
    <keybind key="W-Up"><action name="ToggleMaximize" /></keybind>
    <keybind key="A-F4"><action name="Close" /></keybind>
  </keyboard>
  <windowRules>
    <windowRule identifier="qterminal" serverDecoration="yes" />
    <windowRule identifier="pcmanfm-qt" serverDecoration="yes" />
    <windowRule identifier="lxqt-config" serverDecoration="yes" />
  </windowRules>
</labwc_config>
