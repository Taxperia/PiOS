[Unit]
Description=Project Fidan graphical first-boot session
ConditionPathExists=!/var/lib/fidan/firstboot-complete
After=systemd-user-sessions.service fidan-firstbootd.service

[Service]
Type=simple
User=fidan-setup
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
ExecStart=/usr/bin/dbus-run-session /usr/bin/fidan-session --setup
Restart=on-failure

[Install]
WantedBy=graphical.target

