#!/usr/bin/python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""Collect Pi 5 acceptance evidence without changing configuration. Stress is opt-in."""
import argparse
from datetime import datetime, timezone
import json
from pathlib import Path
import platform
import shutil
import subprocess
import sys


def read(path):
    try:return Path(path).read_text().strip('\x00\n ')
    except OSError:return ''


def probe(arguments):
    if not shutil.which(arguments[0]):return {'status':'unavailable'}
    try:
        result=subprocess.run(arguments,capture_output=True,text=True,timeout=8,check=False)
        return {'status':'observed' if result.returncode==0 else 'failed','exitCode':result.returncode,
                'output':result.stdout[:32768].strip(),'error':result.stderr[:2048].strip()}
    except (OSError,subprocess.TimeoutExpired) as error:return {'status':'failed','error':str(error)}


def collect():
    model=read('/proc/device-tree/model');pi5='Raspberry Pi 5' in model
    complete=Path('/var/lib/fidan/firstboot-complete').is_file()
    report={'schema':1,'timestamp':datetime.now(timezone.utc).isoformat(),'model':model or platform.machine(),
            'pi5':pi5,'kernel':platform.release(),'firstbootComplete':complete,
            'memory':read('/proc/meminfo').splitlines()[:3],'temperatureMillidegrees':read('/sys/class/thermal/thermal_zone0/temp'),
            'hardwareAccepted':False,'manualTests':{name:'not-performed' for name in
                ('clean-card-boot','root-expansion','turkish-setup','english-setup','power-loss-resume','wifi-connect-2.4-and-5ghz',
                 'bluetooth-pair','hdmi-720p-1080p-4k2x','hdmi-and-usb-audio','usb-hotplug','ten-cold-boots',
                 'lock-authentication','signed-update-and-rollback','backup-and-restore','ethernet-browser-setup',
                 'wifi-ap-browser-setup','headless-desktop-input-and-clipboard')}}
    commands={'storage':['lsblk','-J','-o','NAME,SIZE,FSTYPE,MOUNTPOINTS'],
              'networkDevices':['nmcli','-t','-f','TYPE,STATE','device','status'],
              'bluetooth':['bluetoothctl','show'],'audio':['wpctl','status'],'outputs':['wlr-randr','--json'],
              'throttling':['vcgencmd','get_throttled'],'failedServices':['systemctl','--failed','--no-pager','--plain'],
              'loginService':['systemctl','is-enabled','greetd.service'],
              'remoteService':['systemctl','is-active','fidan-gateway.service']}
    report['probes']={name:probe(args) for name,args in commands.items()}
    report['stress']={'status':'not-performed'}
    return report


def main():
    parser=argparse.ArgumentParser(description=__doc__);parser.add_argument('--output',type=Path)
    parser.add_argument('--stress',action='store_true',help='Run stress-ng CPU load for 10 minutes on a connected Pi 5')
    args=parser.parse_args();report=collect()
    if args.stress:
        if not report['pi5']:raise ValueError('Stress mode requires an actual Raspberry Pi 5')
        if not shutil.which('stress-ng'):raise ValueError('Install stress-ng to run the optional load test')
        before=probe(['vcgencmd','get_throttled'])
        result=subprocess.run(['stress-ng','--cpu','0','--timeout','600s','--metrics-brief'],capture_output=True,text=True,timeout=630)
        report['stress']={'status':'observed' if result.returncode==0 else 'failed','exitCode':result.returncode,
                          'before':before,'after':probe(['vcgencmd','get_throttled']),'metrics':result.stderr[-4096:],
                          'temperatureAfterMillidegrees':read('/sys/class/thermal/thermal_zone0/temp')}
    output=json.dumps(report,indent=2)+'\n'
    if args.output:
        # Preserve existing acceptance evidence, including accidental symlink destinations.
        with args.output.open('x',encoding='utf-8') as stream:stream.write(output)
    else:print(output,end='')
    return 0 if report['pi5'] else 2


if __name__=='__main__':
    try:sys.exit(main())
    except (OSError,ValueError,subprocess.SubprocessError) as error:print('test-pi-hardware: '+str(error),file=sys.stderr);sys.exit(1)
