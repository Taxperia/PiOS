#!/usr/bin/python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""Own only Fidan's per-output gamma processes; never terminate other agents."""
import fcntl, hashlib, json, os, re, signal, stat, subprocess, sys, tempfile, time
from pathlib import Path

config = Path(os.environ.get('XDG_CONFIG_HOME', str(Path.home()/'.config'))) / 'fidan/night-light.json'
runtime_root = Path(os.environ.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}'))
runtime = runtime_root / 'fidan-night-light'

def private_directory(path):
    path.mkdir(mode=0o700, parents=True, exist_ok=True)
    descriptor = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        info = os.fstat(descriptor)
        if info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) & 0o077:
            raise PermissionError('Night Light runtime must be owned by this user with mode 0700')
    finally:
        os.close(descriptor)

def private_file(path, truncate=False):
    descriptor = os.open(path, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_NONBLOCK, 0o600)
    try:
        info = os.fstat(descriptor)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_nlink != 1:
            raise PermissionError('Night Light runtime files must be private regular files')
        os.fchmod(descriptor, 0o600)
        if truncate: os.ftruncate(descriptor, 0)
        return os.fdopen(descriptor, 'w' if truncate else 'r+')
    except BaseException:
        os.close(descriptor)
        raise

def read_json(path):
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
        with os.fdopen(descriptor, 'rb') as stream:
            if not stat.S_ISREG(os.fstat(stream.fileno()).st_mode): return {}
            data = stream.read(1024*1024+1)
        if len(data) > 1024*1024: return {}
        value = json.loads(data)
        return value if isinstance(value, dict) else {}
    except (OSError, ValueError): return {}

def save(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, name = tempfile.mkstemp(prefix='.night-light-', dir=path.parent)
    temporary = Path(name)
    try:
        with os.fdopen(descriptor, 'w') as stream: json.dump(data, stream)
        temporary.replace(path)
    finally:
        temporary.unlink(missing_ok=True)

def paths(output):
    token = hashlib.sha256(output.encode()).hexdigest()[:24]
    return runtime / (token+'.json'), runtime / (token+'.log')

def owned(record, output):
    try:
        pid = int(record['pid']); process = Path(f'/proc/{pid}')
        args = (process/'cmdline').read_bytes().split(b'\0')[:-1]
        expected = record['args']
        return pid > 1 and isinstance(expected,list) and expected[:3] == ['wlsunset','-o',output] and process.stat().st_uid == os.getuid() and [a.decode() for a in args] == expected
    except (KeyError, ValueError, TypeError, OSError, UnicodeError): return False

def stop(output):
    path, _ = paths(output); record = read_json(path)
    if owned(record, output):
        os.kill(record['pid'], signal.SIGTERM)
        for _ in range(20):
            if not owned(record, output): break
            time.sleep(.025)
        if owned(record, output): os.kill(record['pid'], signal.SIGKILL)
    path.unlink(missing_ok=True)

def change(command, output, temperature=4500):
    if not output or len(output) > 200 or not 2500 <= temperature <= 6500: raise ValueError('Invalid output or temperature')
    path, log = paths(output)
    if command == 'status':
        record = read_json(path)
        return dict(ok=True, enabled=owned(record, output), temperature=record.get('temperature', temperature))
    stop(output)
    if command == 'on':
        # A 1 K range with fixed sunrise/sunset gives a constant selected
        # temperature without location lookup or a daylight schedule.
        args = ['wlsunset', '-o', output, '-t', str(temperature), '-T', str(temperature+1), '-S', '06:00', '-s', '18:00', '-d', '1']
        with private_file(log, truncate=True) as stream:
            process = subprocess.Popen(args, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=stream, start_new_session=True)
        time.sleep(.35)
        record = dict(pid=process.pid, args=args, temperature=temperature)
        save(path, record)
        message = log.read_text(errors='replace')[-8192:]
        if process.poll() is not None or re.search(r'gamma control.*failed|does not support|failed to connect', message, re.I):
            stop(output)
            raise RuntimeError('Night Light is not supported by this output. '+message.strip())
    preferences = read_json(config)
    preferences[output] = dict(enabled=command == 'on', temperature=temperature)
    save(config, preferences)
    return dict(ok=True, enabled=command == 'on', temperature=temperature)

def main():
    if os.geteuid() == 0: raise RuntimeError('Run Night Light as the desktop user, not root')
    private_directory(runtime_root)
    private_directory(runtime)
    with private_file(runtime/'control.lock') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        command = sys.argv[1]
        if command == 'restore':
            connected = json.loads(subprocess.check_output(['wlr-randr', '--json'], timeout=3))
            names = {o['name'] for o in connected if o.get('enabled')}
            for output, entry in read_json(config).items():
                if output in names and isinstance(entry, dict) and entry.get('enabled'):
                    try: change('on', output, int(entry.get('temperature', 4500)))
                    except (ValueError, RuntimeError, OSError) as error: print(str(error), file=sys.stderr)
            result = dict(ok=True)
        elif command in ('on', 'off', 'status'):
            result = change(command, sys.argv[2], int(sys.argv[3]) if len(sys.argv) > 3 else 4500)
        else: raise ValueError('Usage: fidan-night-light {on|off|status} OUTPUT [KELVIN] | restore')
    print(json.dumps(result))
    return 0

if __name__ == '__main__':
    try: raise SystemExit(main())
    except (OSError, ValueError, RuntimeError, TypeError, IndexError, subprocess.SubprocessError) as error:
        print(json.dumps(dict(ok=False, error=str(error))))
        sys.exit(1)
