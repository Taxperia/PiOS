#!/usr/bin/python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""Own only Fidan's per-output gamma processes; never terminate other agents."""
import fcntl, hashlib, json, os, re, signal, subprocess, sys, time
from pathlib import Path

config = Path(os.environ.get('XDG_CONFIG_HOME', str(Path.home()/'.config'))) / 'fidan/night-light.json'
runtime = Path(os.environ.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}')) / 'fidan-night-light'

def read_json(path):
    try:
        value = json.loads(path.read_text())
        return value if isinstance(value, dict) else {}
    except (OSError, ValueError): return {}

def save(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_suffix('.tmp')
    temporary.write_text(json.dumps(data))
    temporary.chmod(0o600)
    temporary.replace(path)

def paths(output):
    token = hashlib.sha256(output.encode()).hexdigest()[:24]
    return runtime / (token+'.json'), runtime / (token+'.log')

def owned(record):
    try:
        pid = int(record['pid']); process = Path(f'/proc/{pid}')
        args = (process/'cmdline').read_bytes().split(b'\0')[:-1]
        return pid > 1 and process.stat().st_uid == os.getuid() and [a.decode() for a in args] == record['args']
    except (KeyError, ValueError, OSError): return False

def stop(output):
    path, _ = paths(output); record = read_json(path)
    if owned(record):
        os.kill(record['pid'], signal.SIGTERM)
        for _ in range(20):
            if not owned(record): break
            time.sleep(.025)
        if owned(record): os.kill(record['pid'], signal.SIGKILL)
    path.unlink(missing_ok=True)

def change(command, output, temperature=4500):
    if not output or len(output) > 200 or not 2500 <= temperature <= 6500: raise ValueError('Invalid output or temperature')
    path, log = paths(output)
    if command == 'status':
        record = read_json(path)
        return dict(ok=True, enabled=owned(record), temperature=record.get('temperature', temperature))
    stop(output)
    if command == 'on':
        # A 1 K range with fixed sunrise/sunset gives a constant selected
        # temperature without location lookup or a daylight schedule.
        args = ['wlsunset', '-o', output, '-t', str(temperature), '-T', str(temperature+1), '-S', '06:00', '-s', '18:00', '-d', '1']
        with log.open('w') as stream:
            process = subprocess.Popen(args, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=stream, start_new_session=True)
        time.sleep(.35)
        record = dict(pid=process.pid, args=args, temperature=temperature)
        save(path, record)
        message = log.read_text(errors='replace')[-8192:]
        if process.poll() is not None or re.search(r'gamma control.*failed|does not support|failed to connect', message, re.I):
            stop(output)
            raise RuntimeError('Night Light is not supported by this output. '+message.strip())
    preferences = read_json(config)
    preferences[output] = dict(enabled=command == 'on', temperature=temperature)
    save(config, preferences)
    return dict(ok=True, enabled=command == 'on', temperature=temperature)

try:
    runtime.mkdir(mode=0o700, parents=True, exist_ok=True)
    with (runtime/'control.lock').open('w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        command = sys.argv[1]
        if command == 'restore':
            connected = json.loads(subprocess.check_output(['wlr-randr', '--json'], timeout=3))
            names = {o['name'] for o in connected if o.get('enabled')}
            for output, entry in read_json(config).items():
                if output in names and entry.get('enabled'):
                    try: change('on', output, int(entry.get('temperature', 4500)))
                    except (ValueError, RuntimeError, OSError) as error: print(str(error), file=sys.stderr)
            result = dict(ok=True)
        elif command in ('on', 'off', 'status'):
            result = change(command, sys.argv[2], int(sys.argv[3]) if len(sys.argv) > 3 else 4500)
        else: raise ValueError('Usage: fidan-night-light {on|off|status} OUTPUT [KELVIN] | restore')
    print(json.dumps(result))
except (OSError, ValueError, RuntimeError, IndexError, subprocess.SubprocessError) as error:
    print(json.dumps(dict(ok=False, error=str(error))))
    sys.exit(1)
