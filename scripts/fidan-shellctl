#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
set -eu

case "${1:-}" in
  settings)
    exec qdbus6 org.fidan.Shell /Shell org.fidan.Shell1.OpenSettingsPage "${2:-System}"
    ;;
  launcher)
    [ "${2:-toggle}" = "toggle" ] || exit 2
    exec qdbus6 org.fidan.Shell /Shell org.fidan.Shell1.ToggleLauncher
    ;;
  quick-settings)
    [ "${2:-toggle}" = "toggle" ] || exit 2
    exec qdbus6 org.fidan.Shell /Shell org.fidan.Shell1.ToggleQuickSettings
    ;;
  workspace)
    exec qdbus6 org.fidan.Shell /Shell org.fidan.Shell1.SetWorkspace "${2:?workspace number required}"
    ;;
  *)
    echo "usage: fidan-shellctl {launcher|quick-settings|workspace|settings} [toggle|number|page]" >&2
    exit 2
    ;;
esac
