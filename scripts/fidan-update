#!/usr/bin/python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""Check GitHub, verify signed PiOS releases and update installed PiOS packages."""
import argparse
import fcntl
import hashlib
import io
import json
import os
from pathlib import Path
import re
import shutil
import stat
import subprocess
import sys
import tempfile
import urllib.error
import urllib.request
from urllib.parse import urlsplit

PACKAGE = re.compile(r'fidan-[a-z0-9+.-]+')
TAG = re.compile(r'v[0-9]+\.[0-9]+\.[0-9]+(?:-(?:alpha|beta|rc)\.[0-9]+)?')
METADATA_LIMIT = 2 * 1024 * 1024
PACKAGE_LIMIT = 2 * 1024 * 1024 * 1024


def private_directory(path):
    path.mkdir(parents=True, exist_ok=True, mode=0o700)
    descriptor = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        info = os.fstat(descriptor)
        if info.st_uid != os.geteuid() or info.st_mode & 0o022:
            raise RuntimeError('The update cache must be owned by this account and not writable by other accounts')
    finally:
        os.close(descriptor)


def copy_bounded(source, output, limit):
    remaining = limit
    while chunk := source.read(min(1024 * 1024, remaining + 1)):
        if len(chunk) > remaining:
            raise RuntimeError('Update file exceeds the allowed size')
        output.write(chunk)
        remaining -= len(chunk)


def snapshot(source, target, limit):
    # Reject FIFOs/devices and symlinks before reading mutable user input as root.
    descriptor = os.open(source, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(descriptor, 'rb') as stream:
        info = os.fstat(stream.fileno())
        if not stat.S_ISREG(info.st_mode):
            raise RuntimeError('Update input must be a regular file')
        if info.st_size > limit:
            raise RuntimeError('Update file exceeds the allowed size')
        with target.open('xb') as output:
            copy_bounded(stream, output, limit)


def product_manifest():
    for path in (Path('/usr/share/fidan/product.json'), Path(__file__).resolve().parents[1] / 'config/product.json'):
        if path.is_file():
            return json.loads(path.read_text(encoding='utf-8'))
    raise RuntimeError('Product manifest is missing')


def request_json(url):
    request = urllib.request.Request(url, headers={'Accept': 'application/vnd.github+json', 'User-Agent': 'PiOS-Updater/2'})
    with urllib.request.urlopen(request, timeout=30) as response:
        buffer = io.BytesIO()
        copy_bounded(response, buffer, METADATA_LIMIT)
        return json.loads(buffer.getvalue())


def download(url, target):
    parsed = urlsplit(url)
    if parsed.scheme != 'https' or parsed.hostname != 'github.com':
        raise RuntimeError('Release assets must use HTTPS on github.com')
    descriptor, name = tempfile.mkstemp(prefix='.download-', dir=target.parent)
    partial = Path(name)
    try:
        request = urllib.request.Request(url, headers={'User-Agent': 'PiOS-Updater/2'})
        with os.fdopen(descriptor, 'wb') as output, urllib.request.urlopen(request, timeout=90) as response:
            copy_bounded(response, output, PACKAGE_LIMIT if target.suffix == '.deb' else METADATA_LIMIT)
        partial.replace(target)
    finally:
        partial.unlink(missing_ok=True)


def debian_version(version):
    return re.sub(r'-(alpha|beta|rc)\.', r'~\1', version.removeprefix('v'))


def newer(installed, candidate):
    return subprocess.run(['dpkg', '--compare-versions', debian_version(candidate), 'gt', debian_version(installed)], check=False).returncode == 0


def architecture():
    return subprocess.check_output(['dpkg', '--print-architecture'], text=True).strip()


def cache_root():
    if os.geteuid() == 0:
        return Path('/var/cache/fidan/updates')
    return Path(os.environ.get('XDG_CACHE_HOME', Path.home() / '.cache')) / 'fidan/updates'


def notify(title, body):
    if executable := shutil.which('notify-send'):
        subprocess.run([executable, title, body], check=False)


def automatic_enabled():
    if not shutil.which('systemctl'):
        return False
    return subprocess.run(['systemctl', 'is-enabled', '--quiet', 'fidan-auto-update.timer'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0


def latest_release(product):
    releases = request_json(f"https://api.github.com/repos/{product['githubRepo']}/releases?per_page=100")
    if not isinstance(releases, list):
        raise RuntimeError('GitHub returned an invalid release list')
    channel = product.get('channel', 'stable')
    candidates = []
    for release in releases:
        if not isinstance(release, dict) or release.get('draft') or not TAG.fullmatch(str(release.get('tag_name', ''))):
            continue
        tag = release['tag_name']
        if not release.get('prerelease') and '-' not in tag:
            candidates.append(release)
        elif channel != 'stable' and re.search(rf'-{re.escape(channel)}\.', tag):
            candidates.append(release)
    latest = None
    for candidate in candidates:
        if latest is None or newer(latest['tag_name'], candidate['tag_name']):
            latest = candidate
    return latest


def asset_map(release, product):
    expected = f"https://github.com/{product['githubRepo']}/releases/download/{release['tag_name']}/"
    return {a['name']: a['browser_download_url'] for a in release.get('assets', [])
            if isinstance(a, dict) and isinstance(a.get('name'), str) and '/' not in a['name']
            and isinstance(a.get('browser_download_url'), str) and a['browser_download_url'].startswith(expected)}


def verified_checksums(directory, keyring):
    if not keyring.is_file():
        raise RuntimeError(f'Release trust key is missing: {keyring}')
    subprocess.run(['gpgv', '--keyring', str(keyring), str(directory / 'SHA256SUMS.asc'), str(directory / 'SHA256SUMS')], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
    checksums = {}
    for line in (directory / 'SHA256SUMS').read_text(encoding='utf-8').splitlines():
        match = re.fullmatch(r'([0-9a-f]{64})  ([A-Za-z0-9][A-Za-z0-9._+~:-]*)', line)
        if not match or match[2] in checksums:
            raise RuntimeError('The signed checksum list is invalid')
        checksums[match[2]] = match[1]
    return checksums


def verified_manifest(directory, product):
    expected = verified_checksums(directory, Path(product['updateKeyring']))
    data = (directory / 'release.json').read_bytes()
    if hashlib.sha256(data).hexdigest() != expected.get('release.json'):
        raise RuntimeError('Release manifest checksum verification failed')
    manifest = json.loads(data)
    tag = manifest.get('tag', '')
    if manifest.get('schema') != 1 or manifest.get('repository') != product['githubRepo'] or not TAG.fullmatch(tag):
        raise RuntimeError('Release manifest identity is invalid')
    if manifest.get('version') != tag.removeprefix('v'):
        raise RuntimeError('Release manifest version is invalid')
    version = manifest.get('debianVersion', '')
    if version != debian_version(tag) + '-1':
        raise RuntimeError('Release package version does not match its tag')
    packages = manifest.get('packages')
    if not isinstance(packages, list) or not packages:
        raise RuntimeError('The release contains no packages')
    seen = set()
    for package in packages:
        if not isinstance(package, dict):
            raise RuntimeError('Invalid package entry')
        name, package_id, arch = package.get('name', ''), package.get('package', ''), package.get('architecture', '')
        if not PACKAGE.fullmatch(package_id) or package_id.endswith('-dbgsym') or arch not in ('all', 'amd64', 'arm64'):
            raise RuntimeError('Invalid release package identity')
        original_name = f'{package_id}_{version}_{arch}.deb'
        if name not in (original_name, original_name.replace('~', '.')) or name in seen or expected.get(name) != package.get('sha256'):
            raise RuntimeError('Invalid release package checksum or filename')
        seen.add(name)
    return manifest


def compatible_packages(manifest):
    arch = architecture()
    packages = [p for p in manifest['packages'] if p['architecture'] in ('all', arch)]
    if not any(p['architecture'] == arch for p in packages):
        raise RuntimeError(f'This release has no packages for {arch}')
    return packages


def command_check(product, show_notification=False):
    release = latest_release(product)
    tag = release['tag_name'] if release else ''
    available = bool(tag and newer(product['version'], tag))
    assets = asset_map(release, product) if release else {}
    installable = all(name in assets for name in ('release.json', 'SHA256SUMS', 'SHA256SUMS.asc'))
    ready = bool(available and (cache_root() / tag / 'ready.json').is_file())
    print(json.dumps({'installed': product['version'], 'latest': tag.removeprefix('v'), 'updateAvailable': available,
                      'installable': installable, 'downloaded': ready, 'automaticEnabled': automatic_enabled(),
                      'url': release.get('html_url', '') if release else ''}, ensure_ascii=False))
    if show_notification and available:
        notify('PiOS güncellemesi', f'{tag} kullanılabilir. Ayarlar → Sistem bölümünü açın.')
    return 0


def download_release(product):
    release = latest_release(product)
    if not release or not newer(product['version'], release['tag_name']):
        return None
    assets = asset_map(release, product)
    directory = cache_root() / release['tag_name']
    private_directory(cache_root())
    private_directory(directory)
    (directory / 'ready.json').unlink(missing_ok=True)
    for name in ('SHA256SUMS', 'SHA256SUMS.asc', 'release.json'):
        if name not in assets:
            raise RuntimeError(f'Release is missing {name}')
        download(assets[name], directory / name)
    manifest = verified_manifest(directory, product)
    if manifest['tag'] != release['tag_name']:
        raise RuntimeError('Signed release tag differs from GitHub tag')
    for package in compatible_packages(manifest):
        name = package['name']
        if name not in assets:
            raise RuntimeError(f'Release is missing {name}')
        target = directory / name
        download(assets[name], target)
        with target.open('rb') as stream:
            digest = hashlib.file_digest(stream, 'sha256').hexdigest()
        if digest != package['sha256']:
            target.unlink(missing_ok=True)
            raise RuntimeError(f'Checksum verification failed for {name}')
    descriptor, name = tempfile.mkstemp(prefix='.ready-', dir=directory)
    ready = Path(name)
    try:
        with os.fdopen(descriptor, 'w') as stream:
            json.dump({'tag': manifest['tag']}, stream)
        ready.replace(directory / 'ready.json')
    finally:
        ready.unlink(missing_ok=True)
    return directory


def installed_version(package):
    result = subprocess.run(['dpkg-query', '-W', '-f=${db:Status-Status}\t${Version}', package], capture_output=True, text=True, check=False)
    status, _, version = result.stdout.partition('\t')
    return version.strip() if result.returncode == 0 and status == 'installed' else ''


def install_verified(product, source):
    if os.geteuid() != 0:
        raise RuntimeError('The privileged installer must run as root')
    source = source.resolve()
    with tempfile.TemporaryDirectory(prefix='fidan-update-') as name:
        staging = Path(name)
        # Snapshot mutable metadata before verifying it as root.
        for filename in ('SHA256SUMS', 'SHA256SUMS.asc', 'release.json'):
            snapshot(source / filename, staging / filename, METADATA_LIMIT)
        manifest = verified_manifest(staging, product)
        if not newer(product['version'], manifest['version']):
            raise RuntimeError('Refusing an update that is not newer than the installed PiOS version')
        selected = []
        for package in compatible_packages(manifest):
            current = installed_version(package['package'])
            if not current:
                continue
            if not newer(current, manifest['debianVersion']):
                if newer(manifest['debianVersion'], current):
                    raise RuntimeError('Refusing to downgrade an installed PiOS package')
                continue
            target = staging / package['name']
            snapshot(source / package['name'], target, PACKAGE_LIMIT)
            with target.open('rb') as stream:
                digest = hashlib.file_digest(stream, 'sha256').hexdigest()
            if digest != package['sha256']:
                raise RuntimeError(f"Checksum verification failed for {package['name']}")
            fields = subprocess.check_output(['dpkg-deb', '-f', str(target), 'Package', 'Version', 'Architecture'], text=True)
            actual = dict(line.split(': ', 1) for line in fields.splitlines())
            if actual != {'Package': package['package'], 'Version': manifest['debianVersion'], 'Architecture': package['architecture']}:
                raise RuntimeError('Debian package metadata differs from signed manifest')
            selected.append(str(target))
        if not selected:
            raise RuntimeError('No installed PiOS Debian packages need this update')
        env = dict(os.environ, DEBIAN_FRONTEND='noninteractive', NEEDRESTART_MODE='l')
        return subprocess.run(['apt-get', '-o', 'Dpkg::Options::=--force-confold', 'install', '-y', '--no-remove', '--', *selected], env=env, check=False).returncode


def command_install(product):
    candidates = list(cache_root().glob('v*/ready.json'))
    if not candidates:
        raise RuntimeError('No verified update has been downloaded')
    latest = candidates[0].parent
    for candidate in candidates[1:]:
        if newer(latest.name, candidate.parent.name):
            latest = candidate.parent
    if os.geteuid() == 0:
        return install_verified(product, latest)
    return subprocess.run(['pkexec', str(Path(__file__).resolve()), '_install-verified', str(latest)], check=False).returncode


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest='command', required=True)
    check = commands.add_parser('check'); check.add_argument('--notify', action='store_true')
    commands.add_parser('download')
    commands.add_parser('install')
    commands.add_parser('auto', help='As root, download and install newer signed releases for installed PiOS packages')
    configure = commands.add_parser('configure', help='Enable or disable automatic updates after authorization')
    configure.add_argument('state', choices=('on', 'off'))
    internal = commands.add_parser('_install-verified', help=argparse.SUPPRESS); internal.add_argument('directory', type=Path)
    arguments = parser.parse_args()
    try:
        product = product_manifest()
        if arguments.command == 'configure':
            if os.geteuid() != 0:
                return subprocess.run(['pkexec', str(Path(__file__).resolve()), 'configure', arguments.state], check=False).returncode
            return subprocess.run(['systemctl', 'enable' if arguments.state == 'on' else 'disable', '--now', 'fidan-auto-update.timer'], check=False).returncode
        lock = None
        if arguments.command in ('auto', 'install', '_install-verified') and os.geteuid() == 0:
            runtime = Path('/run/fidan-update')
            runtime.mkdir(mode=0o700, exist_ok=True)
            if runtime.is_symlink() or runtime.stat().st_uid != 0 or runtime.stat().st_mode & 0o022:
                raise RuntimeError('The updater runtime directory is not root-owned and private')
            lock = (runtime / 'update.lock').open('w')
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        if arguments.command == 'check':
            return command_check(product, arguments.notify)
        if arguments.command in ('download', 'auto'):
            if arguments.command == 'auto' and os.geteuid() != 0:
                raise RuntimeError('Automatic installation must run as root via systemd')
            directory = download_release(product)
            if directory is None:
                print(json.dumps({'downloaded': False})); return 0
            if arguments.command == 'auto':
                return install_verified(product, directory)
            print(json.dumps({'downloaded': True, 'directory': str(directory)})); return 0
        if arguments.command == 'install':
            return command_install(product)
        return install_verified(product, arguments.directory)
    except (RuntimeError, OSError, ValueError, KeyError, TypeError, urllib.error.URLError, subprocess.CalledProcessError) as error:
        print(f'fidan-update: {error}', file=sys.stderr)
        return 1


if __name__ == '__main__':
    raise SystemExit(main())
