#!/usr/bin/python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""Check, download and install signed Project Fidan GitHub releases."""

import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile
import urllib.error
import urllib.request


def product_manifest() -> dict:
    candidates = [Path("/usr/share/fidan/product.json"), Path(__file__).resolve().parents[1] / "config/product.json"]
    for candidate in candidates:
        if candidate.is_file():
            return json.loads(candidate.read_text(encoding="utf-8"))
    raise RuntimeError("Product manifest is missing")


def request_json(url: str):
    request = urllib.request.Request(url, headers={"Accept": "application/vnd.github+json", "User-Agent": "Project-Fidan-Updater/1"})
    with urllib.request.urlopen(request, timeout=20) as response:
        return json.load(response)


def download(url: str, target: Path) -> None:
    request = urllib.request.Request(url, headers={"User-Agent": "Project-Fidan-Updater/1"})
    partial = target.with_suffix(target.suffix + ".part")
    with urllib.request.urlopen(request, timeout=60) as response, partial.open("wb") as output:
        shutil.copyfileobj(response, output)
    partial.replace(target)


def newer(installed: str, candidate: str) -> bool:
    candidate = candidate.removeprefix("v").replace("-alpha.", "~alpha")
    installed = installed.replace("-alpha.", "~alpha")
    return subprocess.run(["dpkg", "--compare-versions", candidate, "gt", installed], check=False).returncode == 0


def notify(title: str, body: str) -> None:
    executable = shutil.which("notify-send")
    if executable:
        subprocess.run([executable, title, body], check=False)


def latest_release(product: dict) -> dict:
    releases = request_json(f"https://api.github.com/repos/{product['githubRepo']}/releases?per_page=30")
    if not isinstance(releases, list):
        raise RuntimeError("GitHub returned an invalid release list")
    channel = product.get("channel", "stable")
    for release in releases:
        if not isinstance(release, dict) or release.get("draft"):
            continue
        tag = str(release.get("tag_name", "")).lower()
        if channel == "stable":
            if not release.get("prerelease"):
                return release
        elif release.get("prerelease") and re.search(rf"[-~]{re.escape(channel)}(?:[.-]|$)", tag):
            return release
    raise RuntimeError(f"No published {channel} release was found")


def command_check(product: dict, show_notification: bool) -> int:
    release = latest_release(product)
    tag = release.get("tag_name", "")
    available = bool(tag) and newer(product["version"], tag)
    print(json.dumps({"installed": product["version"], "latest": tag.removeprefix("v"),
                      "updateAvailable": available, "url": release.get("html_url", "")}, ensure_ascii=False))
    if show_notification and available:
        notify("Project Fidan update available", f"{tag} is ready. Run: fidan-update download")
    return 0


def asset_map(release: dict) -> dict[str, str]:
    return {asset["name"]: asset["browser_download_url"] for asset in release.get("assets", [])
            if isinstance(asset, dict) and asset.get("name") and asset.get("browser_download_url")}


def verified_checksums(directory: Path, keyring: Path) -> dict[str, str]:
    if not keyring.is_file():
        raise RuntimeError(f"Release keyring is not installed: {keyring}")
    if not shutil.which("gpgv"):
        raise RuntimeError("gpgv is required to verify release signatures")
    checksums = directory / "SHA256SUMS"
    signature = directory / "SHA256SUMS.asc"
    if not checksums.is_file() or not signature.is_file():
        raise RuntimeError("The signed checksum files are missing")
    subprocess.run(["gpgv", "--keyring", str(keyring), str(signature), str(checksums)], check=True)
    expected: dict[str, str] = {}
    for line in checksums.read_text(encoding="utf-8").splitlines():
        match = re.fullmatch(r"([0-9a-fA-F]{64})\s+\*?([^/]+)", line.strip())
        if match:
            expected[match.group(2)] = match.group(1).lower()
    return expected


def command_download(product: dict) -> int:
    release = latest_release(product)
    tag = release.get("tag_name", "")
    if not tag or not newer(product["version"], tag):
        print("No newer release is available.")
        return 0
    assets = asset_map(release)
    for required in ("SHA256SUMS", "SHA256SUMS.asc"):
        if required not in assets:
            raise RuntimeError(f"Release is missing {required}")
    keyring = Path(product["updateKeyring"])
    architecture = subprocess.check_output(["dpkg", "--print-architecture"], text=True).strip()
    package_names = sorted(name for name in assets if name.startswith("fidan-") and name.endswith(".deb")
                           and (name.endswith(f"_{architecture}.deb") or name.endswith("_all.deb")))
    if not package_names:
        raise RuntimeError(f"Release has no packages for {architecture}")
    cache = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "fidan" / "updates" / tag
    cache.mkdir(parents=True, exist_ok=True)
    download(assets["SHA256SUMS"], cache / "SHA256SUMS")
    download(assets["SHA256SUMS.asc"], cache / "SHA256SUMS.asc")
    expected = verified_checksums(cache, keyring)
    for name in package_names:
        if name not in expected:
            raise RuntimeError(f"Signed checksum is missing for {name}")
        target = cache / name
        download(assets[name], target)
        if hashlib.sha256(target.read_bytes()).hexdigest() != expected[name]:
            target.unlink(missing_ok=True)
            raise RuntimeError(f"Checksum verification failed for {name}")
    (cache / "release.json").write_text(json.dumps({"tag": tag, "packages": package_names}), encoding="utf-8")
    print(f"Verified update downloaded to {cache}")
    print("Run 'fidan-update install' to approve installation.")
    return 0


def install_verified(product: dict, metadata_path: Path) -> int:
    if os.geteuid() != 0:
        raise RuntimeError("The privileged installer must run as root")
    metadata_path = metadata_path.resolve()
    metadata = json.loads(metadata_path.read_text(encoding="utf-8"))
    names = metadata.get("packages", [])
    package_pattern = re.compile(r"fidan-[a-z0-9+.-]+_[a-zA-Z0-9.+:~-]+_(?:all|[a-z0-9]+)\.deb")
    if not isinstance(names, list) or not names or any(
            not isinstance(name, str) or not package_pattern.fullmatch(name) for name in names):
        raise RuntimeError("The verified update metadata is invalid")
    expected = verified_checksums(metadata_path.parent, Path(product["updateKeyring"]))
    with tempfile.TemporaryDirectory(prefix="fidan-update-") as staging_name:
        staging = Path(staging_name)
        staged_packages = []
        for name in names:
            source = metadata_path.parent / name
            if name not in expected or not source.is_file():
                raise RuntimeError(f"The verified update is missing {name}")
            package_data = source.read_bytes()
            if hashlib.sha256(package_data).hexdigest() != expected[name]:
                raise RuntimeError(f"Checksum verification failed for {name}")
            target = staging / name
            target.write_bytes(package_data)
            if hashlib.sha256(target.read_bytes()).hexdigest() != expected[name]:
                raise RuntimeError(f"Staging verification failed for {name}")
            staged_packages.append(str(target))
        return subprocess.run(["apt-get", "install", "-y", "--", *staged_packages], check=False).returncode


def command_install(product: dict) -> int:
    root = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "fidan" / "updates"
    releases = sorted((path for path in root.glob("*/release.json") if path.is_file()), key=lambda path: path.stat().st_mtime)
    if not releases:
        raise RuntimeError("No verified update has been downloaded")
    metadata_path = releases[-1]
    if os.geteuid() == 0:
        return install_verified(product, metadata_path)
    pkexec = shutil.which("pkexec")
    if not pkexec:
        raise RuntimeError("pkexec is required to authorize installation")
    return subprocess.run([pkexec, str(Path(__file__).resolve()), "_install-verified",
                           str(metadata_path.resolve())], check=False).returncode


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    check = commands.add_parser("check", help="check GitHub for a newer signed release")
    check.add_argument("--notify", action="store_true")
    commands.add_parser("download", help="download and verify release packages")
    commands.add_parser("install", help="install the last verified download after authorization")
    privileged = commands.add_parser("_install-verified", help=argparse.SUPPRESS)
    privileged.add_argument("metadata", type=Path)
    arguments = parser.parse_args()
    try:
        product = product_manifest()
        if arguments.command == "check":
            return command_check(product, arguments.notify)
        if arguments.command == "download":
            return command_download(product)
        if arguments.command == "install":
            return command_install(product)
        return install_verified(product, arguments.metadata)
    except (RuntimeError, OSError, urllib.error.URLError, subprocess.CalledProcessError, json.JSONDecodeError) as error:
        print(f"fidan-update: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
