#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
set -eu

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
: "${FIDAN_RELEASE_GPG_KEY:?FIDAN_RELEASE_GPG_KEY is required}"

key_file=$(mktemp)
gpg_home=$(mktemp -d)
trap 'rm -f "$key_file"; rm -rf "$gpg_home"' EXIT INT TERM
printf '%s' "$FIDAN_RELEASE_GPG_KEY" >"$key_file"
chmod 0700 "$gpg_home"
export GNUPGHOME="$gpg_home"
gpg --batch --import "$key_file"
key_id=$(gpg --batch --with-colons --list-secret-keys | awk -F: '$1 == "sec" { print $5; exit }')
test -n "$key_id"

FIDAN_RELEASE_KEY_ID="$key_id" "$repo_dir/scripts/build-apt-repository"
(cd "$repo_dir/release" && find . -maxdepth 1 -type f ! -name 'SHA256SUMS*' -printf '%f\n' \
    | sort | xargs sha256sum >SHA256SUMS)
gpg --batch --yes --local-user "$key_id" --armor --detach-sign \
    --output "$repo_dir/release/SHA256SUMS.asc" "$repo_dir/release/SHA256SUMS"
gpg --batch --yes --export "$key_id" >"$repo_dir/release/fidan-release-keyring.gpg"

