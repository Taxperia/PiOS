{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-fidan.invalid/schemas/product.schema.json",
  "title": "Fidan product metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "channel", "supportUrl", "githubRepo", "updateKeyring", "accent", "accentDark", "wallpaper"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9.-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "channel": { "enum": ["alpha", "beta", "stable"] },
    "supportUrl": { "type": "string", "format": "uri" },
    "githubRepo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "updateKeyring": { "type": "string", "pattern": "^/" },
    "accent": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "accentDark": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "wallpaper": { "type": "string", "pattern": "^/" }
  }
}

